{
  "expo": {
    "name": "Gateman",
    "slug": "gateman",
    "version": "1.1.7",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gateman",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.snametech.gateman",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "UIBackgroundModes": ["voip", "remote-notification", "audio"],
        "NSMicrophoneUsageDescription": "GateMan needs access to your microphone for emergency voice calls between residents and security.",
        "NSCameraUsageDescription": "Allow GateMan Security to access your camera for emergency video verification.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE_PHONE_CALL",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.INTERNET",
        "android.permission.WAKE_LOCK",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.BLUETOOTH",
        "android.permission.BIND_TELECOM_CONNECTION_SERVICE",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.CALL_PHONE",
        "android.permission.READ_PHONE_STATE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.snametech.gateman",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "./withZegoSounds.js",
      "./withFirebaseSwizzlingFix.js",
      // "./withZegoService",
      [
        "@config-plugins/react-native-callkeep",
        {
          "additionalPermissions": ["BACKGROUND_PRODUCTION"]
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow GateMan to use your location to record your app usage logs."
        }
      ],
      [
        "expo-asset",
        {
          "assets": [
            "./native-assets/zego_incoming.mp3",
            "./native-assets/zego_outgoing.mp3"
          ]
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow GateMan to access your contacts."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow GateMan to access your camera for video calls.",
          "microphonePermission": "Allow GateMan to access your microphone for intercom audio."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow GateMan to access your photos to update group profiles."
        }
      ],
      [
        "expo-file-system",
        {
          "supportsOpeningDocumentsInPlace": true,
          "enableFileSharing": true
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1",
            "useFrameworks": "static",
            "buildReactNativeFromSource": true,
            "bitcode": false
          },
          "android": {
            "enableProguardInReleaseBuilds": true,
            "extraProguardRules": "-keep class com.google.** {*;}\n-keep class io.wazo.callkeep.** {*;}\n-keep class com.google.common.reflect.** {*;}\n-keep class * extends com.facebook.react.bridge.NativeModule {*;}\n-keep class * extends com.facebook.react.bridge.JavaScriptModule {*;}\n-dontwarn com.google.common.reflect.**\n-dontwarn com.facebook.react.**",
            "extraMavenRepos": [
              "https://www.jitpack.io"
            ],
            "includeCompileClasspath": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "@react-native-firebase/app",
        {
          "ios": {
            "useModularHeaders": true
          }
        }
      ],
      "@react-native-firebase/auth",
      "@react-native-community/datetimepicker",
      "expo-av",
      "expo-secure-store",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "986508ab-d7ea-483c-b310-bd21cda01f48"
      }
    },
    "owner": "simonholo",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/986508ab-d7ea-483c-b310-bd21cda01f48"
    }
  }
}
